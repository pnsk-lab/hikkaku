{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".vitepress/dist/**", "_build/**"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "@hikkaku/gobox#build",
        "moonscratch#build",
        "@hikkaku/testing#build"
      ],
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": []
    },
    "build-blocks": {
      "outputs": ["src/blocks/**"]
    },
    "example:build": {
      "dependsOn": ["^example:build", "^@hikkaku/gobox#build"],
      "outputs": ["dist/**", "build/**"],
      "cache": true
    },
    "docs:build": {
      "cache": true,
      "outputs": [".vitepress/dist/**"],
      "dependsOn": [
        "hikkaku-docs#build",
        "hikkaku#build",
        "@repo/example-3d-ball-roll#example:build",
        "@repo/example-3d-cube#example:build",
        "@repo/example-bigint#example:build",
        "@repo/example-bullet-hell#example:build",
        "@repo/example-daw#example:build",
        "@repo/example-gobox-counter#example:build",
        "@repo/example-json-parser#example:build",
        "@repo/example-markdown-renderer#example:build",
        "@repo/example-rectangle#example:build",
        "@repo/example-reversi#example:build",
        "@repo/example-rubiks-cube#example:build",
        "@repo/example-simple#example:build",
        "@repo/example-tesseract#example:build",
        "@repo/example-tetris#example:build"
      ]
    }
  }
}
