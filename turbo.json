{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".vitepress/dist/**", "_build/**"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "@hikkaku/gobox#build",
        "moonscratch#build",
        "@hikkaku/testing#build"
      ],
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": []
    },
    "build-blocks": {
      "outputs": ["src/blocks/**"]
    },
    "example:build": {
      "dependsOn": ["^example:build", "^@hikkaku/gobox#build"],
      "outputs": ["dist/**", "build/**"],
      "cache": true
    },
    "docs:build": {
      "cache": true,
      "outputs": [".vitepress/dist/**"],
      "dependsOn": ["hikkaku-docs#build", "example:build", "hikkaku#build"]
    }
  }
}
